{
  "name": "@ticketrush/observabilite",
  "version": "0.1.0",
  "private": true,
  "description": "Télémétrie commune des services (ADR 017) : SDK OpenTelemetry (traces, métriques, journaux) et journal JSON pino pour NestJS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./demarrer": {
      "default": "./dist/demarrer.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-kafkajs": "^0.34.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.72.1",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.12"
  }
}
