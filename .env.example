# Variables du Docker Compose (ADR 022).
#
# Facultatif : sans fichier .env, le Compose utilise ces mêmes valeurs par défaut.
# Pour les modifier : copier ce fichier en .env (jamais versionné, voir .gitignore).
# Ce sont des valeurs de DÉVELOPPEMENT uniquement.

# PostgreSQL
POSTGRES_DB=ticketrush
POSTGRES_USER=ticketrush
POSTGRES_PASSWORD=ticketrush_dev
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Redpanda (compatible Kafka) — adresse pour les clients lancés hors Docker : localhost:19092
REDPANDA_KAFKA_PORT=19092
REDPANDA_SCHEMA_REGISTRY_PORT=18081
REDPANDA_ADMIN_PORT=9644

# Meilisearch (en développement, la clé maître doit faire au moins 16 caractères)
MEILI_MASTER_KEY=ticketrush_dev_meili_cle_maitre
MEILI_PORT=7700

# Keycloak — console d'administration : http://localhost:8180
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev
# Base de Keycloak, créée dans PostgreSQL par le conteneur keycloak-db-init
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev

# Faux prestataire de paiement
FAUX_PAIEMENT_PORT=3003

# File d'attente
FILE_ATTENTE_PORT=3001
# Clé privée EC P-256 (PKCS#8) des jetons d'admission, sur une ligne avec des \n.
# Vide : clé générée au démarrage (une seule instance). Générer une clé :
#   node -e "crypto.generateKeyPair('ec',{namedCurve:'P-256'},(e,_,k)=>console.log(k.export({type:'pkcs8',format:'pem'}).replace(/\n/g,'\\n')))"
FILE_JETON_CLE_PRIVEE_PEM=
