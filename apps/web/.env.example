# Variables lues par Vite à la construction (préfixe VITE_). Valeurs par défaut dans src/commun/config.ts.
VITE_KEYCLOAK_URL=http://localhost:8000/auth/realms/ticketrush
VITE_KEYCLOAK_CLIENT_ID=ticketrush-web
# Préfixe des appels à la File d'attente (même origine, routé par Traefik).
VITE_API_FILE=/api/file
