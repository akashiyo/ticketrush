{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    // Au build, les contrats sont déjà compilés (pnpm -r build suit l'ordre des dépendances).
    "paths": {}
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test/**"]
}
