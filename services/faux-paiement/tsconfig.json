{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // La vérification des types (étape « typecheck » de la CI) passe avant le build :
    // le paquet d'observabilité est lu depuis ses sources, sans attendre son dist/.
    "paths": {
      "@ticketrush/observabilite": ["../../packages/observabilite/src/index.ts"]
    }
  },
  "include": ["src"]
}
