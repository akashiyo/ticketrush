{
  "realm": "ticketrush",
  "displayName": "TicketRush",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 900,
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr"],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      {
        "name": "default-roles-ticketrush",
        "description": "Rôles attribués à chaque nouvel utilisateur",
        "composite": true,
        "composites": {
          "realm": ["offline_access", "uma_authorization", "acheteur"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        }
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "acheteur",
        "description": "Achète des billets : file d'attente, réservation, paiement, ses billets"
      },
      {
        "name": "organisateur-admin",
        "description": "Tout le dashboard de son organisation, gestion des membres"
      },
      {
        "name": "organisateur-gestionnaire",
        "description": "Gère les événements et les tarifs de son organisation"
      },
      {
        "name": "organisateur-lecteur",
        "description": "Consulte les ventes de son organisation"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-ticketrush"
  },
  "clients": [
    {
      "clientId": "ticketrush-web",
      "name": "Application web TicketRush",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://localhost/*"],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "organisation_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "organisation_id",
            "claim.name": "organisation_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-ticketrush-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ticketrush-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ticketrush-coeur",
      "name": "Service Cœur",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "ticketrush-coeur-secret-dev",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-ticketrush-faux-paiement",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "ticketrush-faux-paiement",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
